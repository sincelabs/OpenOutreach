# The dashboard's only required variable. Everything else — every OPENOUTFIND_* /
# OUTSEND_* field the CLI wizard would ask for — lives in the database and is edited
# on the dashboard itself once you're signed in.
DASHBOARD_PASSWORD=

# Optional. Defaults to /app/data/db.sqlite3 in Docker (matching the openoutreach
# image's own default) or <repo>/data/db.sqlite3 in a checkout. Set this only if
# your SQLite file lives somewhere else.
# OPENOUTREACH_DB=
